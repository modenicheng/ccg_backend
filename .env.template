# Database connection URL
# SQLite (default): sqlite+aiosqlite:///data/game.db
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/ccg
CCG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ccg

# Optional: enable SQL echo logging (true/false)
CCG_DATABASE_ECHO=false

# Redis connection URL
# Example: redis://localhost:6379/0
CCG_REDIS_URL=redis://localhost:6379/0