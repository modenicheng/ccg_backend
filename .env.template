# Database connection URL
# SQLite (default): sqlite+aiosqlite:///data/game.db
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/ccg
CCG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ccg

# Optional: enable SQL echo logging (true/false)
CCG_DATABASE_ECHO=false

# Redis connection URL
# Example: redis://localhost:6379/0
CCG_REDIS_URL=redis://localhost:6379/0

# QQ Music cookie string for authenticated qqmusic_api requests
# Example format: key1=value1; key2=value2; key3=value3
CCG_QQ_MUSIC_COOKIE=pgv_pvid=

# Songlist page fetch tuning
CCG_SONGLIST_FETCH_CONCURRENCY=8
CCG_SONGLIST_FETCH_RETRIES=5
CCG_SONGLIST_FETCH_BACKOFF_SECONDS=0.4

# Audio download retry tuning
CCG_AUDIO_DOWNLOAD_RETRIES=3
CCG_AUDIO_DOWNLOAD_BACKOFF_SECONDS=0.4
CCG_AUDIO_DOWNLOAD_DIR=assets/audio

# Song URL fetch retry tuning
CCG_SONG_URL_RETRIES=3
CCG_SONG_URL_BACKOFF_SECONDS=0.4

# Audio token TTL (seconds)
CCG_AUDIO_TOKEN_TTL=21600